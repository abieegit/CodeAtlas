{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "moduleResolution": "node",
        "rootDir": "src",
        "outDir": "dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": [
        "src"
    ],
    "exclude": [
        "src/test-fixtures"
    ],
    "ts-node": {
        "files": true
    }
}