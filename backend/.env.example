# Copy to backend/.env and fill in the values.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=codeatlas123
NEO4J_DATABASE=neo4j

PORT=5000

LLM_API_KEY=
LLM_API_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_TIMEOUT_MS=60000

# Supabase (Project Settings -> API). Secret key is backend-only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Cloudflare R2 (Build 07) — private object storage for uploaded ZIPs.
# R2 dashboard -> R2 -> API -> Manage API tokens (create an S3-compatible token).
# Endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com ; keep the bucket PRIVATE.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Analysis worker (Build 07). Optional — defaults shown.
WORKER_POLL_INTERVAL_MS=3000
WORKER_STALE_SECONDS=900
