# Copy to .env and adjust for your Neo4j instance.

# Local Neo4j (matches docker-compose.yml)
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=codeatlas123
NEO4J_DATABASE=neo4j

# Neo4j Aura (example - use the values from your Aura instance)
# NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
# NEO4J_USERNAME=<instance-id>
# NEO4J_PASSWORD=<password>
# NEO4J_DATABASE=<instance-id>

PORT=5000

# LLM API for the analysis features (any OpenAI-compatible endpoint,
# e.g. Groq: https://console.groq.com).
LLM_API_KEY=
LLM_API_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_TIMEOUT_MS=60000

# Supabase (Build 06) — Auth + the PostgreSQL database.
# Project Settings -> API in the Supabase dashboard. The dashboard labels map
# as: "Project URL" -> SUPABASE_URL, "Publishable key" (anon) -> SUPABASE_ANON_KEY,
# "Secret key" (service_role) -> SUPABASE_SERVICE_ROLE_KEY.
# (SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY are also accepted as aliases.)
# The secret / service-role key is backend-only: never expose it to the browser,
# and never commit real values — this file is a template.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
